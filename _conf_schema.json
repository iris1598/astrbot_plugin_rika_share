{
  "平台设置": {
    "type": "object",
    "description": "各平台的通用解析、视频时长上限与合并转发限制",
    "invisible": true,
    "items": {
      "DISABLED_PLATFORMS": {
        "description": "禁用的平台(逗号分隔)",
        "type": "string",
        "default": "",
        "hint": "例如: acfun,nga (留空表示全部启用)",
        "invisible": true
      },
      "VIDEO_DURATION_MAXIMUM": {
        "description": "视频/音频最大时长(秒)",
        "type": "int",
        "default": 480,
        "hint": "超过此时长的视频将不会被下载",
        "invisible": true
      },
      "DOUYIN_LIVE_PHOTO_ENABLED": {
        "description": "抖音动态图重建",
        "type": "bool",
        "default": true,
        "hint": "开启后将抖音实况照片与普通动图重建为单文件动态照片；关闭则只发静态主图",
        "invisible": true
      },
      "XHS_CK": {
        "description": "小红书 Cookie",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "从浏览器获取 xiaohongshu.com 的 cookie (可选)",
        "invisible": true
      },
      "FORWARD_MAX_NODES": {
        "description": "单条合并转发最大节点数",
        "type": "int",
        "default": 10,
        "hint": "图集较大时按此值拆成多条合并转发发送，仅对 OneBot(aiocqhttp) 生效",
        "invisible": true
      },
      "FORWARD_MAX_BATCH_MB": {
        "description": "单条合并转发图片体积上限(MB)",
        "type": "int",
        "default": 30,
        "hint": "按图片原始字节累计计算，超出即拆成下一条",
        "invisible": true
      }
    }
  },
  "B站设置": {
    "type": "object",
    "description": "B站 Cookie、下载清晰度、编码偏好与失效监控",
    "invisible": true,
    "items": {
      "BILI_CK": {
        "description": "哔哩哔哩 Cookie",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "从浏览器获取 bilibili.com 的 SESSDATA 值，或使用 /bili_login 扫码登录",
        "invisible": true
      },
      "BILI_QUALITY": {
        "description": "B站视频下载清晰度",
        "type": "string",
        "default": "1080P",
        "options": ["360P", "480P", "720P", "1080P", "1080P+", "4K", "8K"],
        "hint": "可选: 360P, 480P, 720P, 1080P, 1080P+, 4K, 8K",
        "invisible": true
      },
      "BILI_CODEC": {
        "description": "B站视频下载编码格式",
        "type": "string",
        "default": "H264",
        "options": ["H264", "H265", "AV1"],
        "hint": "H264 兼容性最好；所选编码不可用时自动回退",
        "invisible": true
      },
      "BILI_COOKIE_MONITOR_ENABLED": {
        "description": "启用B站Cookie定时监控",
        "type": "bool",
        "default": true,
        "hint": "开启后将定时检测B站Cookie有效性并在响应刷新时自动续期",
        "invisible": true
      },
      "BILI_COOKIE_CHECK_INTERVAL": {
        "description": "B站Cookie检测间隔(秒)",
        "type": "int",
        "default": 3600,
        "hint": "每隔多少秒检测一次Cookie有效性，最小60秒",
        "invisible": true
      }
    }
  },
  "Twitter 设置": {
    "type": "object",
    "description": "Twitter/X 反代（媒体 CDN 与解析接口改走自定义 Worker）",
    "invisible": true,
    "items": {
      "TWITTER_MEDIA_PROXY_ENABLED": {
        "description": "启用 Twitter 反代",
        "type": "bool",
        "default": false,
        "hint": "开启后，推文媒体与解析接口改走自定义反代地址",
        "invisible": true
      },
      "TWITTER_MEDIA_PROXY_BASE": {
        "description": "Twitter 反代地址",
        "type": "string",
        "default": "",
        "hint": "Cloudflare Worker 反代根地址，结尾不要带斜杠",
        "invisible": true
      }
    }
  },
  "解析图片渲染": {
    "type": "object",
    "description": "Pillow 分享卡片样式、配色与字体设置",
    "invisible": true,
    "items": {
      "RENDER_ENABLED": {
        "description": "启用解析图片渲染",
        "type": "bool",
        "default": true,
        "hint": "开启后将解析结果渲染为分享卡片图片；失败时回退文本输出",
        "invisible": true
      },
      "RENDER_STYLE": {
        "description": "卡片样式",
        "type": "string",
        "default": "standard",
        "options": ["standard", "magazine", "immersive", "feed"],
        "hint": "选择卡片布局样式；清单由 card_render/styles 注册表自动维护",
        "invisible": true
      },
      "RENDER_THEME": {
        "description": "卡片配色",
        "type": "string",
        "default": "dark",
        "options": ["dark", "light"],
        "hint": "卡片深 / 浅双色主题",
        "invisible": true
      },
      "RENDER_WIDTH": {
        "description": "卡片宽度(px)",
        "type": "int",
        "default": 800,
        "slider": {"min": 520, "max": 1080, "step": 20},
        "hint": "卡片图片宽度，范围 520-1080",
        "invisible": true
      },
      "RENDER_COVER_FULL_SIZE": {
        "description": "封面全尺寸模式",
        "type": "bool",
        "default": false,
        "hint": "开启后按封面原始宽高比完整展示，不做中心裁切",
        "invisible": true
      },
      "RENDER_FONT_PATH": {
        "description": "自定义渲染字体(可选)",
        "type": "string",
        "default": "",
        "hint": "填写 .ttf/.ttc/.otf 字体文件路径或所在目录；留空自动探测",
        "invisible": true
      },
      "RENDER_PERSONA_WATERMARK": {
        "description": "随会话人格变更署名",
        "type": "bool",
        "default": false,
        "hint": "开启后，卡片右下角水印与纯文本消息头跟随当前会话生效的 AstrBot 人格名称（如「达妮娅解析」）；默认关闭",
        "invisible": true
      },
      "RENDER_BRAND_NAME": {
        "description": "自定义解析署名",
        "type": "string",
        "default": "莉卡解析",
        "hint": "关闭「随会话人格变更署名」（或使用系统默认人格）时展示的卡片水印与消息头署名",
        "invisible": true
      }
    }
  },
  "网页分享设置": {
    "type": "object",
    "description": "非 OneBot 平台将合并转发转为网页链接发送",
    "invisible": true,
    "items": {
      "WEBPAGE_FALLBACK_ENABLED": {
        "description": "合并转发转网页",
        "type": "bool",
        "default": true,
        "hint": "非 OneBot 平台内容汇总为临时网页链接发送",
        "invisible": true
      },
      "WEBPAGE_TDOCS_JUMP": {
        "description": "腾讯文档跳转",
        "type": "bool",
        "default": true,
        "hint": "QQ 系平台经腾讯文档外链跳转页打开分享网页",
        "invisible": true
      }
    }
  },
  "缓存设置": {
    "type": "object",
    "description": "缓存文件过期时间与自动清理间隔",
    "invisible": true,
    "items": {
      "CACHE_TTL_HOURS": {
        "description": "缓存文件过期时间(小时)",
        "type": "int",
        "default": 24,
        "hint": "设为 0 禁用自动清理",
        "invisible": true
      },
      "CACHE_CLEANUP_INTERVAL_MINUTES": {
        "description": "缓存清理检查间隔(分钟)",
        "type": "int",
        "default": 60,
        "hint": "每隔多少分钟检查一次过期缓存",
        "invisible": true
      }
    }
  },
  "Cloudflare 基础设置": {
    "type": "object",
    "description": "未适配链接的网页截图兜底开关、凭据与黑名单",
    "invisible": true,
    "items": {
      "CLOUDFLARE_FALLBACK_ENABLED": {
        "description": "启用 Cloudflare 网页截图 Fallback",
        "type": "bool",
        "default": false,
        "hint": "未匹配任何平台适配器时使用 Cloudflare Browser Rendering 截图",
        "invisible": true
      },
      "CLOUDFLARE_ACCOUNT_ID": {
        "description": "Cloudflare 账号 ID",
        "type": "string",
        "default": "",
        "hint": "Cloudflare Dashboard 中的 Account ID",
        "invisible": true
      },
      "CLOUDFLARE_API_TOKEN": {
        "description": "Cloudflare API Token",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "需具备 Browser Rendering - Edit 权限",
        "invisible": true
      },
      "CLOUDFLARE_TIMEOUT": {
        "description": "截图 API 超时时间(秒)",
        "type": "int",
        "default": 60,
        "hint": "Cloudflare 渲染页面超时，建议 30-120 秒",
        "invisible": true
      },
      "CLOUDFLARE_CACHE_TTL": {
        "description": "截图缓存时间(秒)",
        "type": "int",
        "default": 0,
        "hint": "0 表示不缓存",
        "invisible": true
      },
      "CLOUDFLARE_BLACKLIST": {
        "description": "截图黑名单",
        "type": "list",
        "default": [],
        "hint": "支持域名、通配符或无点关键词",
        "invisible": true
      }
    }
  },
  "Cloudflare 截图设置": {
    "type": "object",
    "description": "浏览器视窗、等待策略、格式与附加请求头等高级参数",
    "invisible": true,
    "items": {
      "CLOUDFLARE_VIEWPORT_WIDTH": {
        "description": "截图视窗宽度(px)",
        "type": "int",
        "default": 1280,
        "invisible": true
      },
      "CLOUDFLARE_VIEWPORT_HEIGHT": {
        "description": "截图视窗高度(px)",
        "type": "int",
        "default": 720,
        "invisible": true
      },
      "CLOUDFLARE_WAIT_UNTIL": {
        "description": "页面加载等待策略",
        "type": "string",
        "default": "networkidle0",
        "options": ["load", "domcontentloaded", "networkidle0", "networkidle2"],
        "invisible": true
      },
      "CLOUDFLARE_GOTO_TIMEOUT": {
        "description": "页面加载超时(毫秒)",
        "type": "int",
        "default": 45000,
        "slider": {"min": 5000, "max": 120000, "step": 5000},
        "invisible": true
      },
      "CLOUDFLARE_FULL_PAGE": {
        "description": "整页截图",
        "type": "bool",
        "default": false,
        "invisible": true
      },
      "CLOUDFLARE_DEVICE_SCALE_FACTOR": {
        "description": "截图清晰度(deviceScaleFactor)",
        "type": "float",
        "default": 1,
        "slider": {"min": 1, "max": 3, "step": 0.5},
        "invisible": true
      },
      "CLOUDFLARE_SCREENSHOT_TYPE": {
        "description": "截图格式",
        "type": "string",
        "default": "png",
        "options": ["png", "jpeg"],
        "invisible": true
      },
      "CLOUDFLARE_SCREENSHOT_QUALITY": {
        "description": "截图质量(仅 jpeg 有效)",
        "type": "int",
        "default": 0,
        "slider": {"min": 0, "max": 100, "step": 5},
        "invisible": true
      },
      "CLOUDFLARE_OMIT_BACKGROUND": {
        "description": "透明背景",
        "type": "bool",
        "default": false,
        "invisible": true
      },
      "CLOUDFLARE_SELECTOR": {
        "description": "指定元素截图(可选)",
        "type": "string",
        "default": "",
        "invisible": true
      },
      "CLOUDFLARE_WAIT_FOR_SELECTOR": {
        "description": "等待元素出现后再截图(可选)",
        "type": "string",
        "default": "",
        "invisible": true
      },
      "CLOUDFLARE_WAIT_FOR_TIMEOUT": {
        "description": "等待元素超时(毫秒)",
        "type": "int",
        "default": 0,
        "invisible": true
      },
      "CLOUDFLARE_USER_AGENT": {
        "description": "自定义 User-Agent",
        "type": "string",
        "default": "",
        "invisible": true
      },
      "CLOUDFLARE_EXTRA_HEADERS": {
        "description": "附加请求头(JSON)",
        "type": "text",
        "default": "",
        "editor_mode": true,
        "editor_language": "json",
        "invisible": true
      },
      "CLOUDFLARE_COOKIES": {
        "description": "附加 Cookie(JSON)",
        "type": "text",
        "default": "",
        "editor_mode": true,
        "editor_language": "json",
        "invisible": true
      }
    }
  },
  "调试设置": {
    "type": "object",
    "description": "错误堆栈日志与对话错误回显策略",
    "invisible": true,
    "items": {
      "DEBUG_LOG_ENABLED": {
        "description": "启用详细错误日志",
        "type": "bool",
        "default": true,
        "invisible": true
      },
      "SEND_ERROR_MESSAGES": {
        "description": "发送插件错误消息",
        "type": "bool",
        "default": false,
        "invisible": true
      }
    }
  },
  "外观设置": {
    "type": "object",
    "description": "控制面板主题风格与明暗配色模式",
    "invisible": true,
    "items": {
      "WEBUI_THEME": {
        "description": "网页主题风格",
        "type": "string",
        "default": "studio",
        "hint": "控制面板布局骨架与视觉主题（内置 studio / glass-center）",
        "invisible": true
      },
      "WEBUI_COLOR_MODE": {
        "description": "网页明暗模式",
        "type": "string",
        "default": "auto",
        "options": ["auto", "light", "dark"],
        "hint": "默认跟随 AstrBot 面板，也可强制亮/暗",
        "invisible": true
      }
    }
  }
}
